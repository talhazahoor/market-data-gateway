# Copy to .env and fill in. .env is gitignored; never commit real keys.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Omit entirely to run with an in-process cache (fine for local and CI).
REDIS_URL=redis://localhost:6379

# Quotes go stale in seconds. Short-interest and sentiment do not, so they are
# cached far longer — this is the single biggest lever on vendor spend.
QUOTE_TTL_SECONDS=5
ANALYTICS_TTL_SECONDS=900

# Cap on any one vendor call, so a slow vendor cannot stop the fallback running.
PROVIDER_TIMEOUT_MS=2000

# Consecutive failures before a vendor is cut off, and how long it stays cut off.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_MS=30000

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

VENDOR_A_URL=https://vendor-a.example.com
VENDOR_A_KEY=replace-me
VENDOR_B_URL=https://vendor-b.example.com
VENDOR_B_KEY=replace-me
VENDOR_C_URL=https://vendor-c.example.com
VENDOR_C_KEY=replace-me
